# Enforce LF line endings for all shell scripts
*.sh text eol=lf

# Enforce LF for other Linux-specific files
*.conf text eol=lf
*.service text eol=lf
*.zsh text eol=lf
zsh_plugins.txt text eol=lf

# Windows files keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Ensure these files are always treated as text
*.md text
*.txt text
